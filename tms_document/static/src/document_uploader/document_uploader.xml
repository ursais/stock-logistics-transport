<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="tms_document.TmsDocumentUploader">
        <FileUploader
            fileUploadClass="'tms_document_uploader'"
            multiUpload="true"
            onUploaded.bind="this.onFileUploaded"
            onUploadComplete.bind="this.onUploadComplete"
        >
            <t t-set-slot="toggler">
                <button type="button" class="btn btn-primary">
                    <i class="fa fa-upload me-1" />
                    <t t-out="this.uploadLabel" />
                </button>
            </t>
        </FileUploader>
    </t>
    <t t-name="tms_document.TmsDocumentFileReplace">
        <FileUploader
            fileUploadClass="'tms_document_file_replace'"
            multiUpload="false"
            onUploaded.bind="this.onFileUploaded"
            onUploadComplete.bind="this.onUploadComplete"
        >
            <t t-set-slot="toggler">
                <button type="button" class="btn btn-secondary">
                    <i class="fa fa-upload me-1" />
                    <t t-out="this.replaceFileLabel" />
                </button>
            </t>
        </FileUploader>
    </t>
</templates>
